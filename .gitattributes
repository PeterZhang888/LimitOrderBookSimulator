* text=auto
*.sh text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
# Empirical and result CSV files include historical byte-level evidence. Keep
# their existing line endings so recorded SHA-256 values remain reproducible.
*.csv -text
*.json text eol=lf
*.png binary
*.pdf binary
*.zip binary
